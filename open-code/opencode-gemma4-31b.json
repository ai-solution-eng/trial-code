{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemma4-31b-fp8",
  "small_model": "",
  "mcp": {},
  "provider": {
    "gemma4-31b-fp8": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLIS - Gemma4 31B FP8",
      "options": {
        "baseURL": "https://.../v1",
        "apiKey": "..."
      },
      "models": {
        "Gemma4-31B-FP8" : {
          "id": "Gemma4-31B-FP8",
          "name": "Gemma 4 31B FP8 - Local",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "options": {
            "reasoning_effort": "high"
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "glob *": "allow",
      "rm *": "deny"
    },
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": "ask",
    "doom_loop": "deny"
  }
}
