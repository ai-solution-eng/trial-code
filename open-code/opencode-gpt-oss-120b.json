{
  "$schema": "https://opencode.ai/config.json",
  "model": "gpt-oss-120b",
  "small_model": "",
  "mcp": {},
  "provider": {
    "mlis": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLIS Local Models - HTTPS",
      "options": {
        "baseURL": "https://.../v1",
        "apiKey": "..."
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "glob *": "allow",
      "rm *": "deny"
    },
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": "ask",
    "doom_loop": "deny"
  }
}
