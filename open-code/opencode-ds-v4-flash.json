{
  "$schema": "https://opencode.ai/config.json",
  "model": "DeepSeek-V4-Flash-0731",
  "small_model": "",
  "mcp": {},
  "provider": {
	"deepseek-https": {
		"npm": "@ai-sdk/openai-compatible",
		"name": "MLIS DeepSeek V4 Flash",
		"options": {
			"baseURL": "https://.../v1",
			"apiKey": "..."
		},
		"models": {
			"DeepSeek-V4-Flash-max-think": {
				"name": "DeepSeek V4 Flash (Max Think)",
				"id": "DeepSeek-V4-Flash-0731",
				"options": {
					"chat_template_kwargs": {
						"thinking": true,
						"reasoning_effort": "max"
					}
				}
			}
		}
	}
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "glob *": "allow",
      "rm *": "deny"
    },
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": "ask",
    "doom_loop": "deny"
  }
}
